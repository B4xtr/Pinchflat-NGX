<div class="theme-surface-raised mx-auto max-w-3xl space-y-5 p-5 text-theme-on-surface">
  <h1 class="text-title-lg font-bold">Migrate to Postgres</h1>
  <%= if @record do %>
    <p>Migration status: <strong>{@record.status}</strong></p>
    <p class="text-theme-on-surface-muted">
      <%= if @processing_held do %>
        Normal processing is held until you review the copied library and restart. Media files stay at their existing paths.
      <% else %>
        Processing follows your saved queue choices. Media files stay at their existing paths.
      <% end %>
    </p>
    <%= if @record.status in ["pending", "failed"] do %>
      <p :if={@record.status == "failed"} class="theme-status-error">
        Migration stopped: {@record.report["error"]}. The target copy was rolled back. Keep the old instance stopped, correct the source or connection and retry.
      </p>
      <.form for={%{}} action={~p"/postgres_migration/start"} class="space-y-4">
        <label class="flex items-start gap-3"><input type="checkbox" name="stopped" value="true" required />The old SQLite instance is stopped and will stay stopped.</label>
        <label class="flex items-start gap-3"><input type="checkbox" name="backup" value="true" required />I have backed up config and downloads together. The target has no existing library; its default settings will be replaced.</label>
        <.button type="submit">Migrate to Postgres</.button>
      </.form>
    <% end %>
    <%= if @record.status == "running" do %>
      <p>
        Creating a retained SQLite snapshot, copying the library and validating every copied field. Refresh to check progress.
      </p>
    <% end %>
    <%= if @record.status in ["pending_review", "completed"] do %>
      <p>Retained SQLite backup: <code class="break-all">{@record.report["backup"]}</code></p>
      <p :if={@record.report["library"]}>
        Downloaded items: {@record.report["library"]["downloaded_items"]}; recorded bytes: {@record.report["library"][
          "recorded_bytes"
        ]}; missing media paths: {@record.report["library"]["missing_media_files"]}. Missing paths are preserved; verify your downloads mount before resuming jobs.
      </p>
      <ul class="space-y-1">
        <li :for={{table, result} <- Enum.sort(@record.report["tables"] || %{})}>
          {table}: {result["rows"]} rows, fields validated
        </li>
      </ul>
      <%= if @record.status == "pending_review" do %>
        <p>
          Source pause choices and file paths were preserved. Queue pauses are not stored in the old SQLite database. Choose which queues should remain paused after restarting.
        </p>
        <.form for={%{}} action={~p"/postgres_migration/complete"} class="space-y-4">
          <label :for={queue <- @queues} class="flex items-center gap-3"><input
            type="checkbox"
            name="paused_queues[]"
            value={queue}
            checked
          />Keep {queue} paused</label>
          <.button type="submit">Confirm Library and Queue Choices</.button>
        </.form>
      <% else %>
        <p>
          <%= if @processing_held do %>
            Restart the container to finish.
          <% else %>
            Migration is complete.
          <% end %>
          Keep your SQLite backup; later PostgreSQL writes will not appear in it.
        </p>
      <% end %>
    <% end %>
    <.link href={~p"/postgres_migration"} class="text-theme-primary underline">Refresh Status</.link>
  <% else %>
    <p>
      This build has no pending SQLite transfer. Configure the PostgreSQL image and SQLITE_MIGRATION_SOURCE to offer the migration.
    </p>
  <% end %>
</div>
