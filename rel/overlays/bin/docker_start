#!/bin/sh
/app/bin/check_file_permissions

if [ $? -ne 0 ]; then
  echo "Filesystem error. Exiting."
  exit 1
fi

echo "Setting umask to ${UMASK}"
umask ${UMASK}

if ! /app/bin/migrate; then
  echo "Database migration failed. Restore the backup or fix the reported error before starting."
  exit 1
fi

cd -P -- "$(dirname -- "$0")"
PHX_SERVER=true exec ./pinchflat start
